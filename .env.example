# ── DRAPE Fashion OS — Environment Config ──
# Copy this file to .env and fill in real values before deploying.

# Server
NODE_ENV=production
PORT=3000

# Database — leave DB_PATH for SQLite (default), or set DATABASE_URL for PostgreSQL
DB_PATH=./backend/drape.db
# DATABASE_URL=postgresql://user:password@host:5432/drape_db

# JWT Secrets — MUST be changed in production (run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_HEX

# CORS — set to your actual frontend domain(s) in production
# Use comma-separated for multiple origins
CORS_ORIGIN=https://yourdomain.com

# Admin credentials (set before seeding — change after first deploy)
# After seed.js runs, admin username is 'admin', password is 'drape2026'
# Change it via the "Change Password" button in the admin portal, or
# POST /api/auth/change-password (requires being logged in as admin).

# Admin portal path — set this to something unique per deployment.
# Defaults to /portal-3ee0946b if unset. Never use /admin or /admin.html.
ADMIN_PATH=portal-3ee0946b

# Optional — if set, the public Social Hub's "Generate with AI" caption
# feature calls the real Anthropic API server-side. If unset, it returns
# mock captions instead. NEVER put this key in frontend code.
# ANTHROPIC_API_KEY=sk-ant-...
