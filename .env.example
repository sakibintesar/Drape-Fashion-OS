# ── DRAPE Fashion OS — Environment Config ──
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env to version control.

# Server
NODE_ENV=production
PORT=3000

# Database — PostgreSQL (REQUIRED)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=drape
# Alternatively, use a single connection string:
# DATABASE_URL=postgresql://user:password@host:5432/drape_db

# Redis (optional — powers rate limiting and session/cache features)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets — REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Run twice — once for ACCESS, once for REFRESH. Each must be different.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# CORS — set to your actual frontend domain(s) in production
# Use comma-separated for multiple origins. Do NOT use * with credentials.
CORS_ORIGIN=https://yourdomain.com

# Anthropic API Key (optional — for AI caption generation)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Auto-seed — set to "true" to run seed.js on container start (Docker/Compose)
# SEED_ON_START=false

# S3 Backup — for automated pg_dump uploads to S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=drape-db-backups
# BACKUP_PREFIX=drape-db
# BACKUP_CRON=0 2 * * *
# BACKUP_RETENTION_DAYS=30

# Admin credentials — set before first seed. Change password after deploy.
# seed.js creates admin user with these values. Change immediately in production.
