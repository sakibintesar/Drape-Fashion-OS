{
  "name": "drape-fashion-os",
  "version": "4.1.1",
  "description": "DRAPE Fashion OS — Full-stack e-commerce for Bangladesh artisan fashion",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/migrations/run.js && node backend/server.js",
    "dev": "npx nodemon backend/server.js",
    "seed": "node backend/seed.js",
    "db:migrate": "node backend/migrations/run.js",
    "backup": "node backend/backup.js",
    "backup:schedule": "node backend/backup.js --schedule",
    "setup": "node backend/seed.js && node backend/server.js",
    "test": "jest --runInBand --verbose"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.9",
    "pg": "^8.22.0",
    "rate-limiter-flexible": "^5.0.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
